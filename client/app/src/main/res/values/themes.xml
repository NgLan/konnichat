<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.KonniChat" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Theme dành riêng cho Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Màu nền khi khởi động -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- Icon hiển thị giữa màn hình -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Thời gian hiện icon (nếu là ảnh động) -->
        <item name="windowSplashScreenAnimationDuration">200</item>
        <!-- Sau khi Splash xong thì chuyển về Theme nào? -->
        <item name="postSplashScreenTheme">@style/Theme.KonniChat</item>
    </style>
</resources>